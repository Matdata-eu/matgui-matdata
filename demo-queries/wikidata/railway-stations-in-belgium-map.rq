#+ name: Map: railway stations in Belgium
#+ description: Railway stations in Belgium with their coordinates (geo:wktLiteral), shown on a map by the Geo plugin.
PREFIX wd:       <http://www.wikidata.org/entity/>
PREFIX wdt:      <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd:       <http://www.bigdata.com/rdf#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?station ?stationLabel ?coordinates WHERE {
  ?station wdt:P31/wdt:P279* wd:Q55488 ;
           wdt:P17 wd:Q31 ;
           wdt:P625 ?coordinates .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,fr,de,nl". }
}
