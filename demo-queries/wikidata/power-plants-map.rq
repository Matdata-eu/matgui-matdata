#+ name: Map: power plants by type in Germany
#+ description: Power stations in Germany with their type and capacity, on a map.
PREFIX wd:       <http://www.wikidata.org/entity/>
PREFIX wdt:      <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd:       <http://www.bigdata.com/rdf#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?plant ?plantLabel ?typeLabel ?capacity ?coordinates WHERE {
  ?plant wdt:P31 ?type ;
         wdt:P17 wd:Q183 ;
         wdt:P625 ?coordinates .
  ?type wdt:P279* wd:Q159719 .
  OPTIONAL { ?plant wdt:P2109 ?capacity }
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,fr,de,nl". }
}
LIMIT 2000
