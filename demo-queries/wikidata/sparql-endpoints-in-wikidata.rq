#+ name: SPARQL endpoints registered in Wikidata
#+ description: Wikidata items with a SPARQL endpoint URL (P5305) - handy to discover new endpoints to try in MatGUI.
PREFIX wd:       <http://www.wikidata.org/entity/>
PREFIX wdt:      <http://www.wikidata.org/prop/direct/>
PREFIX wikibase: <http://wikiba.se/ontology#>
PREFIX bd:       <http://www.bigdata.com/rdf#>
PREFIX rdfs:     <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item ?itemLabel ?endpoint WHERE {
  ?item wdt:P5305 ?endpoint .
  SERVICE wikibase:label { bd:serviceParam wikibase:language "en,fr,de,nl". }
}
ORDER BY ?itemLabel
