#+ name: All labels of a concept
#+ description: All preferred and alternative labels of one concept (Belgium) in every available language.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?kind ?language ?label WHERE {
  VALUES ?concept { <http://publications.europa.eu/resource/authority/country/BEL> }
  VALUES (?property ?kind) { (skos:prefLabel "preferred") (skos:altLabel "alternative") }
  ?concept ?property ?label .
  BIND(LANG(?label) AS ?language)
}
ORDER BY ?language ?kind
