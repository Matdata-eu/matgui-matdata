#+ name: Protein by gene name
#+ description: Finds the human protein encoded by the gene BRCA1, with its sequence length.
PREFIX up:    <http://purl.uniprot.org/core/>
PREFIX taxon: <http://purl.uniprot.org/taxonomy/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>

SELECT ?protein ?name ?length WHERE {
  ?protein a up:Protein ;
           up:organism taxon:9606 ;
           up:reviewed true ;
           up:encodedBy/skos:prefLabel "BRCA1" ;
           up:recommendedName/up:fullName ?name ;
           up:sequence/rdf:value ?sequence .
  BIND(STRLEN(?sequence) AS ?length)
}
