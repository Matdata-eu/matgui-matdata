#+ name: Map: operational points in Belgium
#+ description: Operational points with their WKT geometry, ready for the Geo plugin. The geometry is looked up generically (any geo:wktLiteral one or two hops away), so it works whatever geometry property the graph uses.
PREFIX era:  <http://data.europa.eu/949/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX country: <http://publications.europa.eu/resource/authority/country/>

SELECT ?op ?name ?wkt WHERE {
  ?op a era:OperationalPoint ;
      era:inCountry country:BEL ;
      era:opName ?name .
  { ?op ?p ?wkt . } UNION { ?op ?p ?geometry . ?geometry ?q ?wkt . }
  FILTER(DATATYPE(?wkt) = geo:wktLiteral)
}
