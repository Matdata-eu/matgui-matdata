#+ name: Map: sections of line in Luxembourg
#+ description: Sections of line in Luxembourg drawn as lines between their start and end operational points (built with CONCAT when no line geometry is available).
PREFIX era:  <http://data.europa.eu/949/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX country: <http://publications.europa.eu/resource/authority/country/>

SELECT ?sol ?from ?to ?length ?wkt WHERE {
  ?sol a era:SectionOfLine ;
       era:inCountry country:LUX ;
       era:opStart ?start ;
       era:opEnd ?end .
  OPTIONAL { ?sol era:lengthOfSectionOfLine ?length }
  ?start era:opName ?from .
  ?end   era:opName ?to .
  { ?start ?p1 ?startWkt . } UNION { ?start ?p1 ?g1 . ?g1 ?q1 ?startWkt . }
  FILTER(DATATYPE(?startWkt) = geo:wktLiteral)
  { ?end ?p2 ?endWkt . } UNION { ?end ?p2 ?g2 . ?g2 ?q2 ?endWkt . }
  FILTER(DATATYPE(?endWkt) = geo:wktLiteral)
  BIND(REPLACE(STR(?startWkt), "^.*POINT\\s*\\(\\s*([-0-9.]+\\s+[-0-9.]+).*$", "$1", "i") AS ?a)
  BIND(REPLACE(STR(?endWkt),   "^.*POINT\\s*\\(\\s*([-0-9.]+\\s+[-0-9.]+).*$", "$1", "i") AS ?b)
  BIND(STRDT(CONCAT("LINESTRING(", ?a, ", ", ?b, ")"), geo:wktLiteral) AS ?wkt)
}
