#+ name: Map: operational points around Brussels
#+ description: Filters Belgian operational points on a bounding box by extracting longitude/latitude from the WKT string, so it works without a spatial index.
PREFIX era:  <http://data.europa.eu/949/>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX country: <http://publications.europa.eu/resource/authority/country/>

SELECT ?op ?name ?wkt WHERE {
  ?op a era:OperationalPoint ;
      era:inCountry country:BEL ;
      era:opName ?name .
  { ?op ?p ?wkt . } UNION { ?op ?p ?geometry . ?geometry ?q ?wkt . }
  FILTER(DATATYPE(?wkt) = geo:wktLiteral)
  BIND(REPLACE(STR(?wkt), "^.*POINT\\s*\\(\\s*([-0-9.]+)\\s+([-0-9.]+).*$", "$1", "i") AS ?lonStr)
  BIND(REPLACE(STR(?wkt), "^.*POINT\\s*\\(\\s*([-0-9.]+)\\s+([-0-9.]+).*$", "$2", "i") AS ?latStr)
  BIND(xsd:decimal(?lonStr) AS ?lon)
  BIND(xsd:decimal(?latStr) AS ?lat)
  FILTER(?lon > 4.20 && ?lon < 4.50 && ?lat > 50.76 && ?lat < 50.92)
}
