#+ name: Update frequencies
#+ description: The frequency authority table used for dct:accrualPeriodicity.
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

SELECT DISTINCT ?frequency ?label WHERE {
  GRAPH <http://publications.europa.eu/resource/authority/frequency> {
    ?frequency a skos:Concept ;
          skos:prefLabel ?label .
    FILTER(LANG(?label) = "en")
  }
}
