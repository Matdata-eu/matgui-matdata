#+ name: Data catalogues
#+ description: The catalogues harvested by data.europa.eu with their title and country.
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?catalogue ?title ?spatial WHERE {
  ?catalogue a dcat:Catalog ;
             dct:title ?title .
  FILTER(LANGMATCHES(LANG(?title), "en") || LANG(?title) = "")
  OPTIONAL { ?catalogue dct:spatial ?spatial }
}
ORDER BY ?title
LIMIT 500
