#+ name: Top publishers of transport data
#+ description: Organisations publishing the most datasets in the Transport theme.
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX theme: <http://publications.europa.eu/resource/authority/data-theme/>

SELECT ?publisher (SAMPLE(?name) AS ?publisherName) (COUNT(DISTINCT ?dataset) AS ?datasets) WHERE {
  ?dataset dcat:theme theme:TRAN ;
           dct:publisher ?publisher .
  OPTIONAL { ?publisher foaf:name ?name }
}
GROUP BY ?publisher
ORDER BY DESC(?datasets)
LIMIT 25
