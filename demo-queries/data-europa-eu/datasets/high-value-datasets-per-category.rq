#+ name: High-value datasets per category
#+ description: Counts datasets declared as high-value datasets (Implementing Regulation (EU) 2023/138) per HVD category.
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcatap: <http://data.europa.eu/r5r/>

SELECT ?category ?label (COUNT(DISTINCT ?dataset) AS ?datasets) WHERE {
  ?dataset a dcat:Dataset ;
           dcatap:hvdCategory ?category .
  OPTIONAL { ?category skos:prefLabel ?label . FILTER(LANG(?label) = "en") }
}
GROUP BY ?category ?label
ORDER BY DESC(?datasets)
