#+ name: Publishers of railway data
#+ description: Organisations publishing datasets tagged 'railway', ranked by number of datasets.
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT ?publisher (SAMPLE(?name) AS ?publisherName) (COUNT(DISTINCT ?dataset) AS ?datasets) WHERE {
  VALUES ?keyword { "railway"@en "railway" "railways"@en }
  ?dataset dcat:keyword ?keyword ;
           dct:publisher ?publisher .
  OPTIONAL { ?publisher foaf:name ?name }
}
GROUP BY ?publisher
ORDER BY DESC(?datasets)
LIMIT 25
