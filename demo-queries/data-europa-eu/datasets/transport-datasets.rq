#+ name: Transport datasets
#+ description: Datasets classified under the DCAT-AP data theme 'Transport' (TRAN).
PREFIX dcat: <http://www.w3.org/ns/dcat#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX theme: <http://publications.europa.eu/resource/authority/data-theme/>

SELECT ?dataset ?title ?modified WHERE {
  ?dataset a dcat:Dataset ;
           dcat:theme theme:TRAN ;
           dct:title ?title .
  FILTER(LANGMATCHES(LANG(?title), "en"))
  OPTIONAL { ?dataset dct:modified ?modified }
}
LIMIT 200
