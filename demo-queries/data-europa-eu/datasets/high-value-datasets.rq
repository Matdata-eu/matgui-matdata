#+ name: High-value datasets
#+ description: Datasets declared as high-value datasets (Implementing Regulation (EU) 2023/138), with their HVD category.
PREFIX dcat:   <http://www.w3.org/ns/dcat#>
PREFIX dct:    <http://purl.org/dc/terms/>
PREFIX dcatap: <http://data.europa.eu/r5r/>

SELECT ?dataset ?title ?category WHERE {
  ?dataset dcatap:hvdCategory ?category ;
           dct:title ?title .
  FILTER(LANGMATCHES(LANG(?title), "en"))
}
LIMIT 200
