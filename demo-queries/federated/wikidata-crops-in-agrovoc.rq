#+ name: Wikidata + AGROVOC: cereals in two vocabularies
#+ description: Cereals in Wikidata that carry an AGROVOC ID (P2004); their French and Spanish labels are fetched from the FAO AGROVOC thesaurus itself.
PREFIX wd:   <http://www.wikidata.org/entity/>
PREFIX wdt:  <http://www.wikidata.org/prop/direct/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skosxl: <http://www.w3.org/2008/05/skos-xl#>

SELECT ?crop ?cropLabel ?agrovoc ?fr ?es WHERE {
  SERVICE <https://query.wikidata.org/sparql> {
    SELECT ?crop ?cropLabel ?agrovocId WHERE {
      ?crop wdt:P279 wd:Q12117 ;
            wdt:P2004 ?agrovocId ;
            rdfs:label ?cropLabel .
      FILTER(LANG(?cropLabel) = "en")
    }
    LIMIT 25
  }
  BIND(IRI(CONCAT("http://aims.fao.org/aos/agrovoc/", ?agrovocId)) AS ?agrovoc)
  SERVICE <https://agrovoc.fao.org/sparql> {
    ?agrovoc skosxl:prefLabel/skosxl:literalForm ?fr, ?es .
    FILTER(LANG(?fr) = "fr" && LANG(?es) = "es")
  }
}
ORDER BY ?cropLabel
